target/
# maven-javadoc-plugin drops an empty <module>/reports/apidocs next to target/ when it
# resolves cross-module links outside a site build ("Creating fake javadoc directory").
*/reports/
# Local output of .github/scripts/build-javadoc-site.sh
/site/
.m2/
.claude/settings.local.json
.qwen/
docs/diagrams/plantuml.jar
bom.xml
bom.json
.idea/
# Gradle build output and caches
build/
.gradle/

# VibeTags generated artifacts
vibetags.log
.vibetags-cache

# .vibetags-mod-* is deliberately NOT ignored. Each file is one module's guardrail block,
# and the root aggregate in CLAUDE.md / GEMINI.md is assembled from whichever ones are on
# disk: a region whose mod file is absent is dropped, not preserved. async-test-lib is the
# first reactor module, so on a tree without them it wrote an aggregate holding only its
# own block and deleted the agent and analysis regions (#423). Committing them is what
# makes the aggregate independent of build order and of which modules a build touched.
#
# The per-module .vibetags-mod-_root_ caches stay ignored: they carry regionId=_root_, no
# region in any aggregate references them, and the current processor no longer writes them.
*/.vibetags-mod-_root_

# AI / tooling caches
.antigravitycli/
.pytest_cache/
# .vibetags-locks is the processor's opt-in signal for its locks_report service, not a
# cache. While it exists, every build adds a locks_report= line to each tracked
# .vibetags-mod-* file; Guardrail Drift's clean build never has it, so those lines fail
# the gate (#466). Delete it before regenerating the mod files for a commit.
.vibetags-locks
evals/results/
.claude/lineage/

# Axiom AST index, written by `axiom scan` into the repository it indexes.
# 53 MB for this repository, regenerated in one command, and specific to
# whichever working copy produced it.
.axiom/
__pycache__/
*.pyc
