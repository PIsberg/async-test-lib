<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The Maven plugin that attaches async-test-agent at JVM startup (#1045): one plugin block,
         async-test:prepare-agent, in place of the dependency:properties execution and the surefire
         argLine the README's quick start used to need, and composing with JaCoCo's prepare-agent the
         same way JaCoCo composes with anything else, through the argLine property. A build of its own,
         outside the reactor and outside the release, until publishing it is decided (#1099).
         CI installs it locally for consumer-fixture-langs/quickstart-plugin. -->
    <parent>
        <groupId>se.deversity.async-test-lib</groupId>
        <artifactId>async-test-satellite-versions</artifactId>
        <version>1.0.0</version>
        <relativePath>../versions/pom.xml</relativePath>
    </parent>

    <artifactId>async-test-maven-plugin</artifactId>
    <version>${async-test.version}</version>
    <packaging>maven-plugin</packaging>
    <name>async-test Maven plugin</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 3.9.x, not 3.10: the plugin descriptor takes its minimum Maven from this API, and the
             project pins 3.9.16 (docs/BUILDING.md). -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven-plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven-plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven-plugin-tools.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven-plugin-tools.version}</version>
                <configuration>
                    <goalPrefix>async-test</goalPrefix>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
