<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The Maven plugin that attaches async-test-agent at JVM startup (#1045): one plugin block,
         async-test:prepare-agent, in place of the dependency:properties execution and the surefire
         argLine the README's quick start used to need, and composing with JaCoCo's prepare-agent the
         same way JaCoCo composes with anything else, through the argLine property. A build of its own,
         outside the reactor, versioned with the library through versions/pom.xml. publish.yml deploys
         it to Maven Central with every release, in a bundle of its own after the reactor's (#1099);
         CI installs it locally for consumer-fixture-langs/quickstart-plugin. -->
    <parent>
        <groupId>se.deversity.async-test-lib</groupId>
        <artifactId>async-test-satellite-versions</artifactId>
        <version>1.0.0</version>
        <relativePath>../versions/pom.xml</relativePath>
    </parent>

    <artifactId>async-test-maven-plugin</artifactId>
    <version>${async-test.version}</version>
    <packaging>maven-plugin</packaging>
    <name>async-test Maven plugin</name>
    <description>Starts the test JVM with -javaagent:async-test-agent.jar through the argLine property, as jacoco:prepare-agent does, so @AsyncTest sees unmodified code.</description>
    <url>https://github.com/PIsberg/async-test-lib</url>

    <!-- Central requires these on the published pom. The parent is never published, so they live
         here rather than being inherited; flatten-maven-plugin below writes them into the pom that
         is deployed. -->
    <licenses>
        <license>
            <name>PolyForm Noncommercial License 1.0.0</name>
            <url>https://polyformproject.org/licenses/noncommercial/1.0.0/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>PIsberg</id>
            <name>Peter Isberg</name>
            <url>https://github.com/PIsberg</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/PIsberg/async-test-lib</url>
        <connection>scm:git:https://github.com/PIsberg/async-test-lib.git</connection>
        <developerConnection>scm:git:https://github.com/PIsberg/async-test-lib.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/PIsberg/async-test-lib/issues</url>
    </issueManagement>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 3.9.x, not 3.10: the plugin descriptor takes its minimum Maven from this API, and the
             project pins 3.9.16 (docs/BUILDING.md). -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven-plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven-plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven-plugin-tools.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven-plugin-tools.version}</version>
                <configuration>
                    <goalPrefix>async-test</goalPrefix>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <!-- The pom that is installed and deployed has no parent and a literal version: this
                 pom's parent is versions/pom.xml, which is never published, and its version is a
                 property of that parent. A consumer resolving the plugin from a repository must need
                 neither. ossrh mode keeps exactly what Central requires (name, description, url,
                 licenses, developers, scm) plus the resolved dependencies. Bound in every build, not
                 only the release, so e2e-tests.yml's quickstart-plugin consumes the flattened pom from
                 the local repository and the release deploys a pom CI has already resolved. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>ossrh</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- The same release profile as the reactor's: sources and javadoc jars, GPG signatures, and the
         Central Portal upload through central-publishing-maven-plugin with waitUntil=uploaded.
         publish.yml runs `mvn -f async-test-maven-plugin/pom.xml clean deploy -P release` after the
         reactor's deploy and before .github/scripts/wait-for-central.sh, which polls this artifact
         too. The plugin versions are shared with the reactor pom.xml through versions/pom.xml;
         SatelliteVersionsTest holds them equal. -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <doclint>all</doclint>
                            <encoding>UTF-8</encoding>
                            <docencoding>UTF-8</docencoding>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- Key is imported from MAVEN_GPG_PRIVATE_KEY env var before mvn runs -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <!-- uploaded, not published, for the reason the reactor pom gives:
                                 wait-for-central.sh verifies availability afterwards. -->
                            <waitUntil>uploaded</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
