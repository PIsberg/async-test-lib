<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>se.deversity.async-test-lib</groupId>
        <artifactId>consumer-fixture-langs</artifactId>
        <version>1.12.2</version>
    </parent>
    <artifactId>consumer-fixture-kotlin</artifactId>
    <name>Async Test Consumer Fixture (Kotlin)</name>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>se.deversity.async-test-lib</groupId>
            <artifactId>async-test-agent</artifactId>
            <version>${async-test.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                </configuration>
                <executions>
                    <execution>
                        <id>test-compile</id>
                        <goals><goal>test-compile</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <!-- The agent jar's own path, so the argLine below can name it (#714). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>resolve-agent-jar-path</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>properties</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- premain rather than self-attach: a self-attach that is refused turns the
                         wait gates into skips, and a skipped gate is not a passed gate. includes=
                         is scoped to the bean package so the two race-condition fixtures next door
                         keep running unwoven (#714). -->
                    <argLine>-javaagent:${se.deversity.async-test-lib:async-test-agent:jar}=includes=com.example.kotlinfixture,collections=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
