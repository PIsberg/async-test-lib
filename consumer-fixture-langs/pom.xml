<?xml version="1.0" encoding="UTF-8"?>
<!--
  Language fixtures: @AsyncTest driven from Kotlin, Groovy, Scala and Clojure, each as a
  downstream consumer of the published async-test-lib artifact (mavenLocal first, then Central,
  exactly like consumer-fixture/). One module per language, the same two-class shape in each:
  an unguarded twin that RaceConditionDetector must report, a guarded twin it must not.

  Sibling of consumer-fixture/, not part of it: that module is the subject of the seven-version
  JUnit compatibility matrix, and four compilers inside it would multiply that matrix.
  The plan and the per-language traps: docs/analysis/jvm-languages-plan.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>se.deversity.async-test-lib</groupId>
        <artifactId>async-test-satellite-versions</artifactId>
        <version>1.0.0</version>
        <relativePath>../versions/pom.xml</relativePath>
    </parent>

    <groupId>se.deversity.async-test-lib</groupId>
    <artifactId>consumer-fixture-langs</artifactId>
    <version>1.13.1</version>
    <packaging>pom</packaging>

    <name>Async Test Consumer Fixture (JVM languages)</name>
    <description>@AsyncTest consumed from Kotlin, Groovy, Scala and Clojure</description>

    <modules>
        <module>kotlin</module>
        <module>groovy</module>
        <module>scala</module>
        <module>clojure</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>se.deversity.async-test-lib</groupId>
            <artifactId>async-test-lib</artifactId>
            <version>${async-test.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <!-- Skip the LicenseGuard's network gate (the fixture is offline).
                                 The tests also set licenseMockMode = true on the annotation, so a
                                 consumer copying one class gets the same behaviour. -->
                            <license.mock.mode>true</license.mock.mode>
                            <!-- A detector that throws during analysis fails the build, not one stderr line (#612) -->
                            <async-test.strict-detectors>true</async-test.strict-detectors>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
