SHARED_MATCHER = agent_matcher_oneInstanceForEveryThread, agent_matcher_oneInstancePerThread
SHARED_DECIMAL_FORMAT = agent_decimalFormat_oneInstanceForEveryThread, agent_decimalFormat_oneInstancePerThread
STATEFUL_LAMBDA = recorded_lambda_sharedAndMutatingItsCapture, recorded_lambda_confinedToItsOwnThread
SYSTEM_PROPERTY_MUTATION = recorded_systemProperty_mutatedByEveryThread, recorded_systemProperty_mutatedOnAPrivateKey
