[0.022226, "o", "\u001b[1masync-test\u001b[0m — catch concurrency bugs before they reach production\r\n\r\n"]
[1.023851, "o", "\r\n\u001b[2m# 1. A shared ArrayList accessed from 6 concurrent threads\u001b[0m\r\n"]
[1.725669, "o", "\u001b[32m$\u001b[0m \u001b[1mcat tools/demo/src/test/java/se/deversity/asynctest/demo/SharedListTest.java\u001b[0m\r\n"]
[2.229148, "o", "package se.deversity.asynctest.demo;\r\n\r\nimport se.deversity.asynctest.AsyncTest;\r\nimport se.deversity.asynctest.AsyncTestContext;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\n/**\r\n * Demonstrates SharedCollectionDetector catching a shared ArrayList across threads.\r\n * Used by the demo GIF workflow (tools/demo-commands.sh).\r\n */\r\nclass SharedListTest {\r\n\r\n    // shared across all concurrent threads — ArrayList is NOT thread-safe\r\n    private final List<String> requestLog = new ArrayList<>();\r\n\r\n    @AsyncTest(threads = 6, invocations = 3, detectSharedCollections = true)\r\n    void requestLog_mustBeThreadSafe() {\r\n        AsyncTestContext.sharedCollectionMonitor()\r\n            .registerCollection(requestLog, \"request-log\", \"ArrayList\");\r\n\r\n        // multiple threads writing concurrently — race condition!\r\n        AsyncTestContext.sharedCollectionMonitor()\r\n            .recordWrite(requestLog, \"request-log\", \"add\");\r\n        requestLog.add(\"req-\" + Thread.currentThread().threadId());\r\n    }\r\n}\r\n"]
[2.229318, "o", "\r\n"]
[3.430948, "o", "\r\n\u001b[2m# 2. Run the stress test — async-test hammers it with 6 threads × 3 rounds\u001b[0m\r\n"]
[4.132936, "o", "\u001b[32m$\u001b[0m \u001b[1mmvn test -f tools/demo/pom.xml -q 2>&1 || true\u001b[0m\r\n"]
[9.322167, "o", "SLF4J(W): No SLF4J providers were found."]
[9.323163, "o", "\r\n"]
[9.323202, "o", "SLF4J(W): Defaulting to no-operation (NOP) logger implementation\r\nSLF4J(W): See https://www.slf4j.org/codes.html#noProviders for further details.\r\n"]
[9.973933, "o", "\r\nSHARED COLLECTION ISSUES DETECTED:\r\n  Concurrent Write Violations (data corruption risk):\r\n    - request-log (ArrayList): write operations from 18 threads (writes: 18) — DATA CORRUPTION RISK!\r\n  Collection Activity:\r\n    - request-log: reads: 0 from 0 thread(s), writes: 18 from 18 thread(s)\r\n  Why: ArrayList, HashMap, and similar collections are explicitly not thread-safe. Concurrent writes corrupt\r\n       internal array pointers and size counters, causing ArrayIndexOutOfBoundsException, infinite loops inside\r\n       HashMap.get(), or silently lost entries — bugs that appear non-deterministically and are hard to reproduce.\r\n  Fix:\r\n    - Drop-in concurrent replacements: ConcurrentHashMap, ConcurrentLinkedQueue, CopyOnWriteArrayList\r\n    - Wrapper (coarse-grained): Collections.synchronizedList/Map/Set — remember to lock the collection during iteration\r\n    - Thread-confined: only access the collection from one thread; pass results between threads via a queue"]
[9.973985, "o", "\r\n"]
