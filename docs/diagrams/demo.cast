[9.632427, "o", "🟠 HIGH: Potential race conditions detected — unsynchronized writes to shared fields allow threads to overwrite each other's changes, producing lost updates, stale reads, and silently wrong results"]
[9.632455, "o", "\r\n"]
[9.632478, "o", "\r\n"]
