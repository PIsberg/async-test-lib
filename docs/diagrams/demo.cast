[1.018266, "o", "\r\n\u001b[2m# 1. A shared ArrayList accessed from 6 concurrent threads\u001b[0m\r\n"]
[1.719735, "o", "\u001b[32m$\u001b[0m \u001b[1mcat tools/demo/src/test/java/se/deversity/asynctest/demo/SharedListTest.java\u001b[0m\r\n"]
[2.222529, "o", "package se.deversity.asynctest.demo;\r\n\r\nimport se.deversity.asynctest.AsyncTest;\r\nimport se.deversity.asynctest.AsyncTestContext;\r\nimport se.deversity.asynctest.DetectorType;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\n/**\r\n * Demonstrates SharedCollectionDetector catching a shared ArrayList across threads.\r\n * Used by the demo GIF workflow (tools/demo-commands.sh).\r\n */\r\nclass SharedListTest {\r\n\r\n    // shared across all concurrent threads — ArrayList is NOT thread-safe\r\n    private final List<String> requestLog = new ArrayList<>();\r\n\r\n    // includes = exactly this detector and nothing else: keeps the recorded demo\r\n    // focused on the one finding it is about. (Historically also load-bearing: the\r\n    // recording workflow dirties pom.xml before recording, and the since-removed\r\n    // UncommittedChangesDetector printed \"uncommitted files\" findings into the GIF.)\r\n    @AsyncTest(threads = 6, invocations = 3, includes = DetectorType.SHARED_COLLECTIONS)\r\n    void requestLog_mustBeThreadSafe() {\r\n        AsyncTestContext.sharedCollectionMonitor()\r\n            .registerCollection(requestLog, \"request-log\", \"ArrayList\");\r\n\r\n        // multiple threads writing concurrently — race condition!\r\n        AsyncTestContext.sharedCollectionMonitor()\r\n            .recordWrite(requestLog, \"request-log\", \"add\");\r\n        requestLog.add(\"req-\" + Thread.currentThread().threadId());\r\n    }\r\n}\r\n"]
[2.222699, "o", "\r\n"]
[3.424102, "o", "\r\n\u001b[2m# 2. Run the stress test — async-test hammers it with 6 threads × 3 rounds\u001b[0m\r\n"]
[4.125877, "o", "\u001b[32m$\u001b[0m \u001b[1mmvn test -f tools/demo/pom.xml -q 2>&1 || true\u001b[0m\r\n"]
[9.274431, "o", "SLF4J(W): No SLF4J providers were found.\r\nSLF4J(W): Defaulting to no-operation (NOP) logger implementation\r\nSLF4J(W): See https://www.slf4j.org/codes.html#noProviders for further details.\r\n"]
[9.596894, "o", "\r\nSHARED COLLECTION ISSUES DETECTED:\r\n  Concurrent Write Violations (data corruption risk):\r\n    - request-log (ArrayList): write operations from 18 threads (writes: 18) — DATA CORRUPTION RISK (the detector observes sharing, not locks — verify external synchronization or use a per-thread instance)!\r\n  Collection Activity:\r\n    - request-log: reads: 0 from 0 thread(s), writes: 18 from 18 thread(s)\r\n  Why: ArrayList, HashMap, and similar collections are explicitly not thread-safe. Concurrent writes corrupt\r\n       internal array pointers and size counters, causing ArrayIndexOutOfBoundsException, infinite loops inside\r\n       HashMap.get(), or silently lost entries — bugs that appear non-deterministically and are hard to reproduce.\r\n  Fix:\r\n    - Drop-in concurrent replacements: ConcurrentHashMap, ConcurrentLinkedQueue, CopyOnWriteArrayList\r\n    - Wrapper (coarse-grained): Collections.synchronizedList/Map/Set — remember to lock the collection during iteration\r\n    - Thread-confined: only access the collection from one thread; pass results between threads via a queue\r\n"]
[9.948103, "o", "\u001b[0m\u001b[0m"]
[9.956741, "o", "\r\n"]
