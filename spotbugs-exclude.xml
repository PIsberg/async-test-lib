<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs exclude filter for async-test-lib.

    URF_UNREAD_FIELD: Detector state-holder inner classes intentionally capture
    diagnostic data (timestamps, IDs, counters) for future diagnostic use or for
    report construction. These fields are written during instrumentation and read
    (transitively) by the report/toString methods that iterate the enclosing
    collections. SpotBugs' intra-procedural analysis cannot follow the
    ConcurrentHashMap.values() read path back to the individual fields.

    DP_DO_INSIDE_DO_PRIVILEGED: SecurityManager is deprecated and removed in
    Java 17+; doPrivileged blocks are no-ops on Java 21.
-->
<FindBugsFilter>

    <!-- ================================================================
         URF_UNREAD_FIELD — intentional instrumentation / state-holder fields
         ================================================================ -->
    <Match>
        <Bug pattern="URF_UNREAD_FIELD,URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
        <Package name="se.deversity.asynctest.diagnostics"/>
    </Match>
    <Match>
        <Bug pattern="URF_UNREAD_FIELD"/>
        <Package name="se.deversity.asynctest.runner"/>
    </Match>
    <!-- AsyncTestConfig.detectAll is a public API config field read by DetectorRegistry -->
    <Match>
        <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
        <Class name="se.deversity.asynctest.AsyncTestConfig"/>
        <Field name="detectAll"/>
    </Match>

    <!-- ================================================================
         DP_DO_INSIDE_DO_PRIVILEGED — SecurityManager removed in Java 17+
         ================================================================ -->
    <Match>
        <Bug pattern="DP_DO_INSIDE_DO_PRIVILEGED"/>
    </Match>

</FindBugsFilter>
