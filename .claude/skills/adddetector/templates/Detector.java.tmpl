package se.deversity.asynctest.diagnostics;

import se.deversity.asynctest.report.Violation;
import se.deversity.vibetags.annotations.AITestDriven;
import se.deversity.vibetags.annotations.AIThreadSafe;

import java.time.Instant;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.concurrent.ConcurrentHashMap;

/**
 * Detects TODO: <one-line description of the concurrency anti-pattern>.
 *
 * <p>TODO: explain the unsafe pattern, why it corrupts state / hangs / races,
 * and the safe alternative. Keep it concrete — this Javadoc is the spec.
 *
 * <p>Usage:
 * <pre>{@code
 * var d = new {{CLASS}}();
 * d.recordAccess(target, "label", "operation", Thread.currentThread());
 * }</pre>
 *
 * @since {{VERSION}}
 */
@AIThreadSafe(strategy = AIThreadSafe.Strategy.OTHER,
    note = "Per-instance state in ConcurrentHashMap with get-then-computeIfAbsent hot path; "
        + "thread-id/name sets are ConcurrentHashMap.newKeySet().")
@AITestDriven(
    framework = {AITestDriven.Framework.JUNIT_5},
    coverageGoal = 80,
    testLocation = "src/test/java/se/deversity/asynctest/diagnostics/{{CLASS}}Test.java"
)
public final class {{CLASS}} {

    private static final class State {
        final String label;
        final Set<String> operations           = ConcurrentHashMap.newKeySet();
        final Set<Long>   accessingThreadIds   = ConcurrentHashMap.newKeySet();
        final Set<String> accessingThreadNames = ConcurrentHashMap.newKeySet();
        State(String label) { this.label = label; }
    }

    private final Map<Integer, State> instances = new ConcurrentHashMap<>();

    /**
     * Record an access to a tracked instance from the hot path. Allocation-free
     * on the common (already-registered) path — mirror the other diagnostics
     * detectors: get-then-computeIfAbsent, never plain computeIfAbsent.
     *
     * @param target    the object being shared (null-safe)
     * @param label     human-readable label for triage (may be {@code null})
     * @param operation descriptive operation label (may be {@code null})
     * @param thread    the accessing thread
     */
    public void recordAccess(Object target, String label, String operation, Thread thread) {
        if (target == null || thread == null) return;
        int id = System.identityHashCode(target);
        State s = instances.get(id);
        if (s == null) {
            final String lbl = label != null ? label : target.getClass().getSimpleName() + "@" + id;
            s = instances.computeIfAbsent(id, k -> new State(lbl));
        }
        if (operation != null) s.operations.add(operation);
        s.accessingThreadIds.add(thread.threadId());
        s.accessingThreadNames.add(thread.getName());
    }

    /**
     * Evaluate the observed state and produce a report. Must be idempotent:
     * calling it N times on quiescent state yields N identical reports.
     */
    public Report analyze() {
        Report r = new Report();
        for (State s : instances.values()) {
            // TODO: replace this placeholder rule with the real detection condition.
            //       The stub simply flags any instance touched by >1 thread.
            if (s.accessingThreadIds.size() <= 1) continue;
            String msg = String.format(
                    "'%s' accessed from %d threads (%s) via %s — TODO: explain why this is unsafe.",
                    s.label,
                    s.accessingThreadIds.size(),
                    String.join(", ", s.accessingThreadNames),
                    String.join(", ", s.operations));
            r.violations.add(msg);
            r.structuredViolations.add(new Violation(
                    "{{FACTORY}}",
                    IssueSeverity.HIGH,
                    msg,
                    List.of(),
                    Map.of(
                            "label", s.label,
                            "threadCount", s.accessingThreadIds.size()),
                    Instant.now()));
        }
        return r;
    }

    /** Report produced by {@link #analyze()}. {@code hasIssues()} drives the SPI sweep. */
    public static final class Report {
        public final List<String> violations = new ArrayList<>();
        public final List<Violation> structuredViolations = new ArrayList<>();

        public boolean hasIssues() { return !violations.isEmpty(); }

        @Override
        public String toString() {
            if (violations.isEmpty()) return "{{FACTORY}} — clean";
            StringBuilder sb = new StringBuilder("{{FACTORY}} DETECTED:\n");
            for (String v : violations) sb.append("  - ").append(v).append('\n');
            sb.append("  Fix:\n")
              .append("    - TODO: state the safe pattern.\n");
            return sb.toString();
        }
    }
}
