<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>se.deversity.async-test-lib</groupId>
    <artifactId>corpus-eval</artifactId>
    <version>1.9.7</version>
    <packaging>jar</packaging>

    <name>Async Test Corpus Eval</name>
    <description>Measures what the detectors report on third-party library code with a documented
        thread-safety contract. Standalone on purpose: nothing here reaches the reactor or a
        published artifact.</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <async-test.version>1.9.7</async-test.version>
        <junit.jupiter.version>6.1.3</junit.jupiter.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <commons-collections4.version>4.5.0</commons-collections4.version>
        <guava.version>33.4.8-jre</guava.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>se.deversity.async-test-lib</groupId>
            <artifactId>async-test-lib</artifactId>
            <version>${async-test.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>se.deversity.async-test-lib</groupId>
            <artifactId>async-test-agent</artifactId>
            <version>${async-test.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- The corpus. Subjects, not tools: their javadoc states the thread-safety contract
             that this eval uses as ground truth. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>${commons-collections4.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- Self-attach needs the flag; Surefire forks its own JVM. -->
                    <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
                    <systemPropertyVariables>
                        <license.mock.mode>true</license.mock.mode>
                        <!-- fields=true is what makes a bare field instruction inside a
                             third-party method body observable. Without it only JavaBean
                             accessors are woven and most subjects are invisible.
                             collections=true adds the other half: a class that keeps its state
                             in a JDK collection writes no field of its own, so without it three
                             of the nine documented-unsafe subjects reported nothing at all. -->
                        <asynctest.agent>fields=true,collections=true</asynctest.agent>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
