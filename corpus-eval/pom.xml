<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>se.deversity.async-test-lib</groupId>
    <artifactId>corpus-eval</artifactId>
    <version>1.11.0</version>
    <packaging>jar</packaging>

    <name>Async Test Corpus Eval</name>
    <description>Measures what the detectors report on third-party library code with a documented
        thread-safety contract. Standalone on purpose: nothing here reaches the reactor or a
        published artifact.</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <async-test.version>1.11.0</async-test.version>
        <junit.jupiter.version>6.1.3</junit.jupiter.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <commons-collections4.version>4.5.0</commons-collections4.version>
        <guava.version>33.4.8-jre</guava.version>
        <jackson.version>2.22.2</jackson.version>
        <caffeine.version>3.2.4</caffeine.version>
        <netty.version>4.2.17.Final</netty.version>
        <spring.version>7.0.9</spring.version>
        <hikaricp.version>7.0.2</hikaricp.version>
        <slf4j.version>2.0.17</slf4j.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-dependency-plugin.version>3.9.0</maven-dependency-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>se.deversity.async-test-lib</groupId>
            <artifactId>async-test-lib</artifactId>
            <version>${async-test.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>se.deversity.async-test-lib</groupId>
            <artifactId>async-test-agent</artifactId>
            <version>${async-test.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- The corpus. Subjects, not tools: their javadoc states the thread-safety contract
             that this eval uses as ground truth. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>${commons-collections4.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
            <version>${netty.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>${spring.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- A real connection pool, for the recording lane only. It is the one subject that
             cannot be exercised without something to pool, which is why it is not in the two
             unmodified lanes: those claim no line of the subject is ours, and a stub DataSource
             would break that claim. The recording lane's body is ours by construction, and the
             code deciding which thread holds which connection is still entirely HikariCP's. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- HikariCP logs through SLF4J and warns on every pool operation without a binding.
             The no-op binding keeps the corpus output readable; nothing here asserts on logs. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <!-- Resolves the agent jar's path into a property, so the launch flag below can
                 name it. Without this the module would have to hard-code a path into the local
                 repository, which differs between a developer machine and CI. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>resolve-agent-jar</id>
                        <goals><goal>properties</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- Self-attach needs the flag; Surefire forks its own JVM. The agent-on
                         lane no longer uses self-attach (see below), but the agent-off lane
                         still proves that nothing attaches, so the flag stays harmless here. -->
                    <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
                </configuration>
                <executions>
                    <!-- Lane one: the agent attached, which is the configuration the write-up
                         quotes and the only one in which an agent-fed detector can see anything. -->
                    <execution>
                        <id>default-test</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <!-- The recording lane has its own execution below; running it here
                                 too would attach the agent to it and make its findings ambiguous
                                 between the woven stream and the body's own recorded calls. -->
                            <excludes>
                                <exclude>**/CorpusRecordingLaneTest.java</exclude>
                                <!-- The agent-pair lane wants the agent, but on its own: it
                                     installs CorpusRecorder and gates per subject, and sharing a
                                     fork with CorpusEvalTest would mix two subject sets into one
                                     static findings list. -->
                                <exclude>**/CorpusAgentPairLaneTest.java</exclude>
                            </excludes>
                            <!-- The agent is attached at JVM startup rather than self-attached
                                 from the first @AsyncTest, and that is a measurement decision,
                                 not a style one. A self-attach happens partway through the run,
                                 and only classes loaded after it are woven, so which subjects the
                                 agent can see depends on which test class Surefire happens to run
                                 first. That ordering differs between a developer machine and a CI
                                 runner, and it moved this eval's detection from 20 of 20 to 6 of
                                 20 with nothing else changed (#316). premain weaves at load time,
                                 before any subject class exists, so the corpus measures the
                                 detectors instead of the file order. -->
                            <argLine>-Djdk.attach.allowAttachSelf=true -javaagent:${se.deversity.async-test-lib:async-test-agent:jar}=fields=true,collections=true</argLine>
                            <systemPropertyVariables>
                                <license.mock.mode>true</license.mock.mode>
                                <corpus.lane>agent-on</corpus.lane>
                                <!-- fields=true is what makes a bare field instruction inside a
                                     third-party method body observable. Without it only JavaBean
                                     accessors are woven and most subjects are invisible.
                                     collections=true adds the other half: a class that keeps its
                                     state in a JDK collection writes no field of its own, so
                                     without it three of the nine documented-unsafe subjects
                                     reported nothing at all. -->
                                <asynctest.agent>fields=true,collections=true</asynctest.agent>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                    <!-- Lane three: nothing attached, and the bodies cooperate. A different
                         measurement over a different denominator, which is why it writes its own
                         report and never merges into the other two. The corpus records nothing by
                         hand, which is what makes its findings attributable to unmodified code and
                         also what leaves 137 of the 142 detectors with an exposure of zero in both
                         other lanes. This lane gives a named handful of them a denominator, by
                         calling the recording API the way a user following AsyncTestContext does.
                         The agent stays detached on purpose: with both feeds live a finding could
                         have come from either, and every assertion here depends on each finding
                         being attributable to a record* call the body made. -->
                    <execution>
                        <id>recording</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/CorpusRecordingLaneTest.java</include>
                            </includes>
                            <reportsDirectory>${project.build.directory}/surefire-reports-recording</reportsDirectory>
                            <systemPropertyVariables>
                                <license.mock.mode>true</license.mock.mode>
                                <corpus.lane>recording</corpus.lane>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                    <!-- Lane four: the agent attached, and the bodies record nothing. The mirror
                         image of lane three. Eighteen detectors are fed by a JDK call site the
                         weaver substitutes and by nothing else, so no record* call reaches them
                         and the recording lane cannot pair them at all. Here the pair is written
                         the way the bug is written - one instance in a static field against one
                         per thread - and everything the detector sees comes from the agent. The
                         same either-or reasoning as lane three, from the other side: exactly one
                         feed is live, so a finding has exactly one possible source, and
                         AgentRowPremise fails the lane if a body touches the recording API. -->
                    <execution>
                        <id>agent-pairs</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/CorpusAgentPairLaneTest.java</include>
                            </includes>
                            <argLine>-Djdk.attach.allowAttachSelf=true -javaagent:${se.deversity.async-test-lib:async-test-agent:jar}=fields=true,collections=true</argLine>
                            <reportsDirectory>${project.build.directory}/surefire-reports-agent-pairs</reportsDirectory>
                            <systemPropertyVariables>
                                <license.mock.mode>true</license.mock.mode>
                                <corpus.lane>agent-pairs</corpus.lane>
                                <asynctest.agent>fields=true,collections=true</asynctest.agent>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                    <!-- Lane two: the same subjects with nothing attached and nothing recorded.
                         It is the control that turns the exposure table from a claim into a
                         measurement: with the agent detached the agent-fed detectors have no
                         input, so the run must observe nothing, and CorpusGates asserts exactly
                         that. Only CorpusEvalTest runs here; TestBodyCollectionIsObservedTest
                         pins the woven path and would be asserting the opposite. -->
                    <execution>
                        <id>agent-off</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/CorpusEvalTest.java</include>
                            </includes>
                            <reportsDirectory>${project.build.directory}/surefire-reports-agent-off</reportsDirectory>
                            <systemPropertyVariables>
                                <license.mock.mode>true</license.mock.mode>
                                <corpus.lane>agent-off</corpus.lane>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
